<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="cs-CZ">
  <info>
    <title>ISO-690 (numeric, Czech, square brackets)</title>
    <id>http://www.zotero.org/styles/iso690-numeric-cs-brackets</id>
    <link href="http://www.zotero.org/styles/iso690-numeric-cs" rel="self"/>
    <link href="http://www.zotero.org/styles/iso690-numeric-cs" rel="template"/>
    <author>
      <name>Custom ISO 690 CZ</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <updated>2026-11-07T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="cs">
    <terms>
      <term name="anonymous">Anonym</term>
      <term name="accessed">cit.</term>
      <term name="available at">Dostupné z</term>
    </terms>
  </locale>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=" – " delimiter-precedes-last="always">
        <name-part name="family" text-case="uppercase"/>
      </name>
    </names>
  </macro>
  <macro name="title">
    <text variable="title" font-style="italic"/>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush">
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <text macro="author" suffix=". "/>
      <text macro="title" suffix=". "/>
      <text variable="publisher" suffix=", "/>
      <date variable="issued">
        <date-part name="year"/>
      </date>
      <text variable="URL" prefix=". Dostupné z: "/>
    </layout>
  </bibliography>
</style>
